{
    "name": "tinkerspower",
    "version": "1.0.0",
    "description": "TinkersPower Minecraft ModPack Project.",
    "main": "index.js",
    "scripts": {
        "ban": "node .manifest/scripts/ban_generator.js",
        "clear_logs": "node .manifest/scripts/clear_logs.js",
        "loot_tables_dir": "node .manifest/scripts/loot_tables_dir.js",
        "defaultconfigs": "node .manifest/scripts/defaultconfigs.js",
        "build_server": "node .manifest/scripts/build_server.js",
        "build_client": "node .manifest/scripts/build_client",
        "build_client_offline": "node .manifest/scripts/build_client_offline.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thisNames/TinkersPower-ModPack.git"
    },
    "author": "animator70@outlook.com",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/thisNames/TinkersPower-ModPack/issues"
    },
    "homepage": "https://github.com/thisNames/TinkersPower-ModPack#readme",
    "devDependencies": {
        "@types/node": "^18.19.130",
        "typescript": "^5.9.3"
    },
    "build": {
        "manifest": ".manifest/manifest.json",
        "modlist": ".manifest/modlist.html",
        "optionsTxt": "options.txt",
        "required": [
            ".manifest",
            "config",
            "defaultconfigs",
            "kubejs",
            "mods",
            "resourcepacks",
            "shaderpacks"
        ],
        "server": {
            ".manifest": {
                "whitelist": true,
                "list": [
                    "^js",
                    "^index.html"
                ],
                "skip": false
            },
            "config": {
                "whitelist": false,
                "list": [
                    "^jei\\\\world",
                    "^spark"
                ],
                "skip": false
            },
            "defaultconfigs": {
                "whitelist": false,
                "list": [],
                "skip": false
            },
            "kubejs": {
                "whitelist": false,
                "list": [
                    "^assets",
                    "^client_scripts",
                    "^probe",
                    "^config\\\\client.properties",
                    "^config\\\\packicon.png",
                    "^config\\\\probejs.json",
                    "^jsconfig.json",
                    "^README.txt"
                ],
                "skip": false
            },
            "mods": {
                "whitelist": false,
                "list": [
                    "^optimize\\.0Pack2Reload",
                    "^optimize\\.entityculling",
                    "^optimize\\.flerovium",
                    "^optimize\\.CullLessLeaves",
                    "^optimize\\.createbetterfps",
                    "^optimize\\.colorwheel",
                    "^optimize\\.gnetum",
                    "^custom\\.d_sound_mixins",
                    "^magic\\.probejs",
                    "^library\\.embeddium",
                    "^decoration\\.mobends",
                    "^decoration\\.JEICopyRecipeJson",
                    "^decoration\\.configured",
                    "^decoration\\.MouseTweaks",
                    "^decoration\\.Controlling",
                    "^decoration\\.Searchables",
                    "^decoration\\.oculus",
                    "^decoration\\.BetterPingDisplay",
                    "^decoration\\.BetterAdvancements",
                    "^decoration\\.EnchantmentDescriptions",
                    "^decoration\\.CustomSkinLoader",
                    "^decoration\\.lanserverproperties",
                    "^decoration\\.OverflowingBars",
                    "^sound\\.AmbientSounds",
                    "^sound\\.PresenceFootsteps",
                    "^sound\\.dynamicsurroundings"
                ],
                "skip": false
            },
            "resourcepacks": {
                "whitelist": true,
                "list": [],
                "skip": true
            },
            "shaderpacks": {
                "whitelist": true,
                "list": [],
                "skip": true
            }
        },
        "client": {
            "online": {
                ".manifest": {
                    "whitelist": true,
                    "list": [
                        "^js",
                        "^index.html"
                    ],
                    "skip": false
                },
                "config": {
                    "whitelist": false,
                    "list": [
                        "^jei\\\\world",
                        "^spark"
                    ],
                    "skip": false
                },
                "defaultconfigs": {
                    "whitelist": false,
                    "list": [],
                    "skip": false
                },
                "kubejs": {
                    "whitelist": false,
                    "list": [
                        "^probe"
                    ],
                    "skip": false
                },
                "mods": {
                    "whitelist": true,
                    "list": [],
                    "skip": true
                },
                "resourcepacks": {
                    "whitelist": false,
                    "list": [],
                    "skip": false
                },
                "shaderpacks": {
                    "whitelist": false,
                    "list": [],
                    "skip": false
                }
            },
            "offline": {
                ".manifest": {
                    "whitelist": true,
                    "list": [
                        "^js",
                        "^index.html"
                    ],
                    "skip": false
                },
                "config": {
                    "whitelist": false,
                    "list": [
                        "^jei\\\\world",
                        "^spark"
                    ],
                    "skip": false
                },
                "defaultconfigs": {
                    "whitelist": false,
                    "list": [],
                    "skip": false
                },
                "kubejs": {
                    "whitelist": false,
                    "list": [
                        "^probe"
                    ],
                    "skip": false
                },
                "mods": {
                    "whitelist": false,
                    "list": [
                        "^magic\\.probejs"
                    ],
                    "skip": false
                },
                "resourcepacks": {
                    "whitelist": false,
                    "list": [],
                    "skip": false
                },
                "shaderpacks": {
                    "whitelist": false,
                    "list": [],
                    "skip": false
                }
            }
        }
    }
}